config:
  clientID: "${client_id}"
  clientSecret: "${client_secret}"
  cookieSecret: "${cookie_secret}"
  # EMPTY -> legacy-config.mode = "no-config" (with forceLegacyConfig=false +
  # alphaConfig.enabled=false). Chart then SKIPS the subPath mount of
  # oauth2_proxy.cfg (configmain) and the --config arg.
  # Config is fed via our own ConfigMap mounted full-dir (no subPath) + extraArgs --config.
  configFile: ""
  forceLegacyConfig: false

alphaConfig:
  enabled: false

# Point oauth2-proxy at the full-dir-mounted config file (NO subPath).
extraArgs:
  config: /etc/oauth2-proxy-config/oauth2_proxy.cfg

extraVolumes: ${jsonencode(oauth2_volumes)}
extraVolumeMounts: ${jsonencode(oauth2_volume_mounts)}

ingress:
  enabled: true
  className: ${ingress_class}
  hosts:
    - ${oauth2_hostname}
  path: /
  pathType: ImplementationSpecific
  annotations:
    cert-manager.io/cluster-issuer: ${cert_manager_cluster_issuer}
  tls:
    - secretName: ${oauth2_hostname}-tls
      hosts:
        - ${oauth2_hostname}

service:
  type: ClusterIP
  portNumber: 4180

# Deployment tuning
replicaCount: 1
resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi
